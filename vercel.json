{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        { "key": "cache-control", "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "cache-control", "value": "no-cache" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "cache-control", "value": "no-cache" }]
    }
  ]
}
